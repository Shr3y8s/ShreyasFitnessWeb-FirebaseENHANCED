{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "copy-config": "node -e \"require('fs').copyFileSync('../../firebase-config.json', './firebase-config.json')\"",
    "lint": "echo 'Skipping lint check for debugging tools'",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest"
  },

  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.0.2",
    "resend": "^6.6.0",
    "stripe": "^18.4.0"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
