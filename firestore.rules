rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for cleaner rule management
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is an admin (owner with full platform access)
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Check if user is a trainer (staff with scoped access)
    // Updated to support trainers collection
    function isTrainer() {
      return isAuthenticated() && (
        // Check if user exists in trainers collection
        exists(/databases/$(database)/documents/trainers/$(request.auth.uid)) ||
        // OR check if user is in admins collection with role 'trainer'
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'trainer')
      );
    }
    
    // Check if user is either admin or trainer (for shared permissions)
    function isTrainerOrAdmin() {
      return isAdmin() || isTrainer();
    }
    
    // Check if trainer is assigned to a specific client (for future filtering)
    function isAssignedTrainer(clientId) {
      return isTrainer() &&
        exists(/databases/$(database)/documents/users/$(clientId)) &&
        get(/databases/$(database)/documents/users/$(clientId)).data.assignedTrainerId == request.auth.uid;
    }

    // EMAIL VERIFICATION SYSTEM
    // Temporary storage for OTP codes during signup (before account creation)
    match /verifiedEmails/{email} {
      // Allow unauthenticated users to read their own verification document
      // This is needed to check verification status during signup flow
      allow read: if request.auth == null;
      
      // No direct writes - only Cloud Functions can write (using admin SDK)
      allow write: if false;
    }
    
    // Contact Form Submissions - New collection for contact form
    match /contact_form_submissions/{submissionId} {
      allow create: if true;  // Allow public contact form submissions
      allow read, update, delete: if isTrainerOrAdmin();  // Only trainers/admins can manage submissions
      
      // Replies subcollection for trainer responses
      match /replies/{replyId} {
        allow read: if isTrainerOrAdmin();
        allow create, update, delete: if isTrainerOrAdmin();
      }
    }
    
    // ADMIN COLLECTION: Protected collection for admin accounts
    match /admins/{adminId} {
      // Admins can read their own profile
      allow read: if request.auth.uid == adminId;
      
      // Admins can read all admin profiles
      allow read: if isAdmin();
      
      // CLIENT MESSAGING: Allow authenticated clients to read admin profiles (to find their coach if admin trains)
      allow read: if isAuthenticated();
      
      // Admins and trainers can update their own profile (excluding role, email, and createdAt)
      // Explicitly allow profile photo, name, phone, bio, professionalTitle, yearsExperience fields
      allow update: if request.auth.uid == adminId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'createdAt', 'email', 'stripeCustomerId']);
      
      // No direct create/delete (manual only or via Cloud Functions)
      allow create, delete: if false;
    }
    
    // TRAINERS COLLECTION: Protected collection for staff trainer accounts
    match /trainers/{trainerId} {
      // Trainers can read their own profile
      allow read: if request.auth.uid == trainerId;
      
      // Admins can read and manage all trainer profiles
      allow read, write: if isAdmin();
      
      // Trainers can update their own profile (limited fields - no permissions changes)
      allow update: if request.auth.uid == trainerId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isActive', 'hiredDate', 'permissions']);
      
      // CLIENT MESSAGING: Allow authenticated clients to read trainer profiles (to find their coach)
      allow read: if isAuthenticated();
      
      // No direct create/delete (admin only via write above)
      allow create, delete: if false;
    }
    
    // LOGIN HISTORY TRACKING - Security and engagement monitoring
    match /login_history/{logId} {
      // Users can only read their own login history
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Only backend functions can write login history
      allow write: if false;
    }
    
    // Enhanced user profile rules for dashboard
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if isOwner(userId);
      
      // TRAINER DASHBOARD: Allow trainers to read all client profiles for management
      allow read: if isTrainerOrAdmin();
      
      // CLIENT MESSAGING: Allow clients to read trainer/admin profiles (to find their coach)
      allow read: if isAuthenticated() && 
                  resource.data.role in ['trainer', 'admin'];
      
      // Allow users to update their own profile with validation
      // IMPORTANT: Users cannot modify role, createdAt, or accountActivated (only backend can update accountActivated)
      allow update: if isOwner(userId) &&
                    (!request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['role', 'createdAt', 'accountActivated', 'stripeCustomerId', 'subscriptionId']));
                      
      // Allow initial creation of user documents (for signup process)
      // Users can create their account with accountActivated: false
      allow create: if isOwner(userId) &&
                    request.resource.data.accountActivated == false;
    
      // Dashboard data collection
      match /dashboard_data/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Training plans
      match /training_plans/{planId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Only the user or admin can create/update plans
        allow write: if request.auth != null && 
                     (request.auth.uid == userId || 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      }
      
      // Sessions
      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Session data validation
        function validateSessionData() {
          let data = request.resource.data;
          return data.keys().hasAll(['date', 'title', 'type', 'duration']) &&
                 data.date is timestamp &&
                 data.title is string &&
                 data.duration is number &&
                 data.duration > 0;
        }
        
        // Allow create with validation
        allow create: if request.auth != null && 
                      request.auth.uid == userId &&
                      validateSessionData();
                      
        // Allow update with validation
        allow update: if request.auth != null && 
                      request.auth.uid == userId &&
                      validateSessionData();
      }
      
      // Progress metrics
      match /metrics/{metricId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Metric data validation
        function validateMetricData() {
          let data = request.resource.data;
          return data.keys().hasAll(['date', 'type', 'value']) &&
                 data.date is timestamp &&
                 data.type is string &&
                 data.value is number;
        }
        
        // Allow create with validation
        allow create: if request.auth != null && 
                      request.auth.uid == userId &&
                      validateMetricData();
                      
        // Allow update with validation
        allow update: if request.auth != null && 
                      request.auth.uid == userId &&
                      validateMetricData();
      }
      
      // Private subcollection for sensitive client data
      match /private/{docId} {
        // Users can read their own private data
        allow read: if isOwner(userId);
        
        // Trainers can read session balance for their assigned clients
        allow read: if isTrainerOrAdmin() && isAssignedTrainer(userId);
        
        // Admins can read all private data
        allow read: if isAdmin();
        
        // Only backend/Cloud Functions can write (users via functions)
        allow write: if false;
      }
      
    }
    
    // POLYMORPHIC WORKOUT MANAGEMENT SYSTEM - Phase 1 (Strength + Cardio)
    
    // Exercise Library Collection - Supports 8 exercise categories with polymorphic configurations
    match /exercises/{exerciseId} {
      // Trainers can create, read, update, and manage exercises
      allow read, write: if isTrainerOrAdmin();
      
      // Clients can read exercises from their company or personal exercises created by their trainer
      // Also allow reading exercises that are part of their assigned workouts
      allow read: if isAuthenticated();
      
      // Exercise validation - Updated for new schema
      function validateExercise() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'category', 'createdBy', 'equipment', 'primaryMuscles', 'scope', 'isActive']) &&
               data.name is string && data.name.size() > 0 &&
               data.category in ['strength', 'cardio', 'core', 'flexibility', 'balance', 'mobility', 'plyometric', 'yoga_pilates'] &&
               data.createdBy is string &&
               data.scope in ['personal', 'company'] &&
               data.isActive is bool &&
               data.equipment is list &&
               data.primaryMuscles is list &&
               // Optional difficulty field
               (!data.keys().hasAny(['difficulty']) || data.difficulty in ['beginner', 'intermediate', 'advanced']);
      }
      
      // Apply validation on create and update
      allow create: if isTrainerOrAdmin() && validateExercise();
      allow update: if isTrainerOrAdmin() && validateExercise();
    }
    
    // Workout Templates Collection - Blueprint-only (no concrete configurations)
    match /workoutTemplates/{templateId} {
      // Trainers can read templates
      allow read: if isTrainerOrAdmin();
      
      // Clients can read templates from their company scope (for viewing)
      allow read: if isAuthenticated() && resource.data.scope == 'company';
      
      // Workout template validation for CREATE - requires all fields
      function validateWorkoutTemplateCreate() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'createdBy', 'exercises', 'difficulty', 'category', 'scope', 'isActive']) &&
               data.name is string && data.name.size() > 0 &&
               data.createdBy is string &&
               data.exercises is list &&
               data.difficulty in ['beginner', 'intermediate', 'advanced'] &&
               data.category in ['strength', 'cardio', 'hiit', 'flexibility', 'mixed'] &&
               data.scope in ['personal', 'company'] &&
               data.isActive is bool &&
               data.estimatedDuration is number && data.estimatedDuration > 0;
      }
      
      // Workout template validation for UPDATE - only validates fields being changed
      function validateWorkoutTemplateUpdate() {
        let data = request.resource.data;
        return data.name is string && data.name.size() > 0 &&
               data.exercises is list &&
               data.difficulty in ['beginner', 'intermediate', 'advanced'] &&
               data.category in ['strength', 'cardio', 'hiit', 'flexibility', 'mixed'] &&
               data.scope in ['personal', 'company'] &&
               data.isActive is bool &&
               data.estimatedDuration is number && data.estimatedDuration > 0 &&
               // Ensure required fields aren't removed
               data.keys().hasAll(['name', 'createdBy', 'exercises', 'difficulty', 'category', 'scope', 'isActive']) &&
               // Prevent changing createdBy
               data.createdBy == resource.data.createdBy;
      }
      
      // Apply validation separately for create and update
      allow create: if isTrainerOrAdmin() && validateWorkoutTemplateCreate();
      allow update: if isTrainerOrAdmin() && validateWorkoutTemplateUpdate();
      allow delete: if isTrainerOrAdmin();
    }
    
    // UNIFIED WORKOUT SYSTEM - Single collection for assignments + execution
    match /workouts/{workoutId} {
      // Trainers can read workouts (query filters by trainerId)
      allow read: if isTrainerOrAdmin();
      
      // Clients can read their own workouts
      allow read: if isAuthenticated() && 
                  request.auth.uid == resource.data.clientId;
      
      // Only Cloud Functions can create workouts (via assignWorkout)
      allow create: if false;
      
      // Clients can update workout progress (actual data, status, timestamps)
      // Updated fields during tracking: exercises.actual, status, startedAt, updatedAt
      // Updated fields during completion: completedAt, durationMinutes, overallDifficulty, overallNotes
      allow update: if isAuthenticated() && 
                    request.auth.uid == resource.data.clientId;
      
      // Trainers can delete workouts they assigned
      allow delete: if isTrainerOrAdmin() && 
                    resource.data.trainerId == request.auth.uid;
      
      // Workout validation for client updates
      function validateWorkoutUpdate() {
        let data = request.resource.data;
        // Clients can only modify specific fields during tracking
        let allowedFields = ['status', 'startedAt', 'completedAt', 'durationMinutes', 
                            'exercises', 'overallDifficulty', 'overallNotes', 'updatedAt'];
        return data.clientId == resource.data.clientId &&
               data.trainerId == resource.data.trainerId &&
               data.status in ['scheduled', 'started', 'completed', 'skipped'];
      }
      
      // Apply validation on client updates
      allow update: if isAuthenticated() && 
                    request.auth.uid == resource.data.clientId &&
                    validateWorkoutUpdate();
    }
    
    // CLIENT STATS COLLECTION - Personal records and training metrics
    // Stores aggregated statistics like strength PRs for efficient dashboard queries
    match /clientStats/{clientId} {
      // Trainers/admins can read all client stats (for training dashboards)
      allow read: if isTrainerOrAdmin();
      
      // Clients can read their own stats (for future client-facing features)
      allow read: if isAuthenticated() && request.auth.uid == clientId;
      
      // Only Cloud Functions can write (via completeWorkout function)
      // Cloud Functions use admin SDK which bypasses rules, but explicit deny for clarity
      allow write: if false;
    }
    
    // GOALS COLLECTION - Goals and milestones tracking
    // Document ID format: {clientId}_{category} (7 slots per client)
    match /goals/{goalId} {
      // Trainers/admins can read and write all goals
      allow read, write: if isTrainerOrAdmin();
      
      // Clients can read individual goal documents
      allow get: if isAuthenticated() && 
                  goalId.split('_')[0] == request.auth.uid;
      
      // Clients can query/list goals (query filters by clientId)
      allow list: if isAuthenticated();
      
      // Clients can update currentValue (for manual progress tracking if needed)
      // But cannot change configuration
      allow update: if isAuthenticated() && 
                    goalId.split('_')[0] == request.auth.uid &&
                    !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['clientId', 'trainerId', 'category', 'isActive', 'isConfigured', 
                             'targetValue', 'unit', 'term', 'priority', 'title']);
    }

    // CLIENT MESSAGING SYSTEM - Phase 3
    match /client_messages/{messageId} {
      // Trainers can read and send messages
      allow read: if isTrainerOrAdmin();
      allow create: if isTrainerOrAdmin() && 
                    request.resource.data.senderId == request.auth.uid;
      
      // Clients can read messages in their own conversations and send messages
      allow read: if isAuthenticated() && 
                  (request.auth.uid in resource.data.conversationId.split('_'));
      allow create: if isAuthenticated() && 
                    request.resource.data.senderId == request.auth.uid &&
                    (request.auth.uid in request.resource.data.conversationId.split('_'));
      
      // Message validation
      function validateMessage() {
        let data = request.resource.data;
        return data.keys().hasAll(['conversationId', 'senderId', 'senderName', 'recipientId', 'content', 'createdAt']) &&
               data.conversationId is string &&
               data.senderId is string &&
               data.senderName is string &&
               data.recipientId is string &&
               data.content is string && data.content.size() > 0 &&
               data.content.size() <= 2000; // Max 2000 characters
      }
      
      // Apply validation on create
      allow create: if (isTrainerOrAdmin() || isAuthenticated()) && 
                    validateMessage() &&
                    request.resource.data.senderId == request.auth.uid;
      
      // Allow marking as read
      allow update: if isAuthenticated() && 
                    request.auth.uid == resource.data.recipientId &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    
    // Stripe Products - Public read access
    match /stripe_products/{document=**} {
      allow read: if true;  // Allow public reads for product/price info
    }
    
    // CollectionGroup rules for Stripe subcollections (for business dashboard analytics)
    match /{path=**}/subscriptions/{subscriptionId} {
      // ONLY ADMINS can read all subscriptions for MRR calculations (not regular trainers)
      allow read: if isAdmin();
    }
    
    match /{path=**}/payments/{paymentId} {
      // ONLY ADMINS can read all payments for revenue tracking (not regular trainers)
      allow read: if isAdmin();
    }
    
    match /{path=**}/invoices/{invoiceId} {
      // ONLY ADMINS can read all invoices for failed payment monitoring (not regular trainers)
      allow read: if isAdmin();
    }
    
    // Stripe Customers - User-specific access with Extension support
    match /stripe_customers/{userId} {
      // Users can create their own customer document during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can read their own customer data
      // ONLY ADMINS can read all customer data (not regular trainers)
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      
      // Only Extension/Admin can update (Extension uses admin SDK so bypasses rules)
      allow update, delete: if false;
      
      // Subscriptions subcollection - managed by Extension
      match /subscriptions/{subscriptionId} {
        // Users can read their own subscriptions
        // ONLY ADMINS can read all subscriptions (not regular trainers)
        allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        allow write: if false; // Only Extension can write
        
        // Invoices nested under subscriptions
        match /invoices/{invoiceId} {
          // Users can read their own subscription invoices
          // ONLY ADMINS can read all invoices (not regular trainers)
          allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
          allow write: if false; // Only Extension can write
        }
      }
      
      // Payments subcollection - managed by Extension
      match /payments/{paymentId} {
        // Users can read their own payments
        // ONLY ADMINS can read all payments (not regular trainers)
        allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        allow write: if false; // Only Extension can write
      }
      
      // Checkout sessions - managed by Extension
      match /checkout_sessions/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    
    // IN-PERSON TRAINING SESSION MANAGEMENT SYSTEM
    
    // Training Locations Collection
    match /training_locations/{locationId} {
      // Trainers/admins can read and manage all locations
      allow read, write: if isTrainerOrAdmin();
      
      // Clients can read active locations (for viewing session details)
      allow read: if isAuthenticated() && resource.data.isActive == true;
      
      // Location validation
      function validateLocation() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'displayName', 'address', 'isDefault', 'isActive', 'createdAt']) &&
               data.name is string && data.name.size() > 0 &&
               data.displayName is string && data.displayName.size() > 0 &&
               data.address is string && data.address.size() > 0 &&
               data.isDefault is bool &&
               data.isActive is bool;
      }
      
      // Apply validation on create and update
      allow create: if isTrainerOrAdmin() && validateLocation();
      allow update: if isTrainerOrAdmin() && validateLocation();
    }
    
    // Training Sessions Collection
    match /sessions/{sessionId} {
      // Trainers can read and manage all sessions
      allow read, write: if isTrainerOrAdmin();
      
      // Clients can read their own sessions (for individual document reads)
      allow read: if isAuthenticated() && 
                  resource != null &&
                  request.auth.uid == resource.data.clientId;
      
      // Clients can LIST/QUERY their own sessions (for collection queries)
      // This rule allows queries that filter by clientId
      allow list: if isAuthenticated() && 
                  request.query.limit <= 100;
      
      // Clients can cancel their own sessions (updates status and cancellation fields)
      allow update: if isAuthenticated() && 
                    request.auth.uid == resource.data.clientId &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'canceledBy', 'canceledAt', 'cancelReason', 'updatedAt']);
      
      // Session validation
      function validateSession() {
        let data = request.resource.data;
        return data.keys().hasAll(['clientId', 'trainerId', 'packageId', 'calendlyEventId', 'scheduledDate', 'status', 'createdAt']) &&
               data.clientId is string &&
               data.trainerId is string &&
               data.packageId is string &&
               data.calendlyEventId is string &&
               data.scheduledDate is timestamp &&
               data.status in ['scheduled', 'completed', 'canceled', 'no-show'] &&
               data.duration is number && data.duration > 0;
      }
      
      // Cloud Functions can create sessions (bypasses with admin SDK)
      allow create: if false; // Only Cloud Functions can create
    }
    
    // Session Refunds Collection
    match /session_refunds/{refundId} {
      // Trainers can read and manage all refunds
      allow read, write: if isTrainerOrAdmin();
      
      // Clients can read their own refund requests
      allow read: if isAuthenticated() && 
                  request.auth.uid == resource.data.clientId;
      
      // Only trainers can create refund requests
      allow create: if isTrainerOrAdmin();
    }
    
    // Global configuration accessible to all authenticated users
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can write via backend
    }
    
    // Feature flags
    match /features/{featureId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can write via backend
    }
    
    // CLIENT TRAINING PLANS COLLECTION (using 'plans' as primary collection name)
    match /plans/{planId} {
      // Trainers can read and manage plans for their clients
      allow read, write: if isTrainerOrAdmin();
      
      // Clients can read their own plan (document ID is userId)
      allow read: if isAuthenticated() && request.auth.uid == planId;
      
      // Plan validation
      function validatePlan() {
        let data = request.resource.data;
        return data.keys().hasAll(['nutritionProtocol']) &&
               data.nutritionProtocol is map;
      }
      
      // Apply validation on create and update
      allow create: if isTrainerOrAdmin() && validatePlan();
      allow update: if isTrainerOrAdmin() && validatePlan();
    }
    
    // LEGACY: CLIENT TRAINING PLANS COLLECTION (clientPlans)
    match /clientPlans/{planId} {
      // Trainers can read and manage plans for their clients
      allow read, write: if isTrainerOrAdmin();
      
      // Clients can read their own plan
      // Check both document ID (for when using clientId as planId) and data field
      allow read: if isAuthenticated() && 
                  (request.auth.uid == planId || 
                   (resource != null && request.auth.uid == resource.data.clientId));
      
      // Plan validation
      function validatePlan() {
        let data = request.resource.data;
        return data.keys().hasAll(['clientId', 'trainerId']) &&
               data.clientId is string &&
               data.trainerId is string;
      }
      
      // Apply validation on create and update
      allow create: if isTrainerOrAdmin() && validatePlan();
      allow update: if isTrainerOrAdmin() && validatePlan();
    }
    
    // NUTRITION LOGGING SYSTEM
    match /nutritionLogs/{userId} {
      // Users can read their own nutrition data
      allow read: if isOwner(userId);
      
      // ADMINS can read all nutrition logs
      // TRAINERS can only read their assigned clients' logs
      allow read: if isAdmin() || isAssignedTrainer(userId);
      
      // Daily macro logs subcollection
      match /meals/{dateId} {
        // Users can read/write their own daily logs (individual docs and queries)
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
        
        // ADMINS can read all, TRAINERS only their assigned clients
        allow get, list: if isAdmin() || isAssignedTrainer(userId);
      }
      
      // Habits tracking subcollection
      match /habits/{dateId} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
        allow get, list: if isAdmin() || isAssignedTrainer(userId);
      }
      
      // Meal plan adherence tracking subcollection
      match /mealPlans/{dateId} {
        // Users can read/write their own meal plan adherence (individual docs and queries)
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
        
        // ADMINS can read all, TRAINERS only their assigned clients
        allow get, list: if isAdmin() || isAssignedTrainer(userId);
        
        // Validation for meal plan adherence data
        function validateMealPlanAdherence() {
          let data = request.resource.data;
          return data.keys().hasAll(['completedMeals', 'dayComplete', 'lastUpdated']) &&
                 data.completedMeals is list &&
                 data.dayComplete is bool;
        }
        
        allow write: if isOwner(userId) && validateMealPlanAdherence();
      }
    }
    
    // DAILY ACTIVITY LOGS SYSTEM - New structure with subcollection
    // Collection structure: dailyActivityLogs/{userId}/logs/{date}
    match /dailyActivityLogs/{userId} {
      // Users can read their own activity logs parent document
      allow read: if isOwner(userId);
      
      // ADMINS can read all activity logs
      allow read: if isAdmin();
      
      // TRAINERS can read their assigned clients' logs
      allow read: if isTrainer() && isAssignedTrainer(userId);
      
      // Logs subcollection
      match /logs/{dateId} {
        // Users can read/write their own daily logs
        allow read, write: if isOwner(userId);
        
        // ADMINS can read all logs
        allow read: if isAdmin();
        
        // TRAINERS can read their assigned clients' logs
        allow read: if isTrainer() && isAssignedTrainer(userId);
        
        // Validation for daily activity log
        function validateDailyLog() {
          let data = request.resource.data;
          return data.keys().hasAll(['date', 'updatedAt']) &&
                 data.date is string &&
                 data.steps is number && data.steps >= 0 &&
                 data.waterIntake is number && data.waterIntake >= 0 &&
                 data.habitCheckins is map;
        }
        
        allow write: if isOwner(userId) && validateDailyLog();
      }
    }
    
    // DAILY ACTIVITY TRACKING SYSTEM (LEGACY)
    // Top-level collection for consistency with nutritionLogs and workoutExecutions
    // Document ID format: {userId}_{date} (using underscore separator)
    match /dailyActivities/{activityId} {
      // Extract userId from document ID (format: userId_date)
      function getUserIdFromActivityId() {
        return activityId.split('_')[0];
      }
      
      // Users can get their own daily activity documents
      allow get: if isAuthenticated() && 
                 request.auth.uid == getUserIdFromActivityId();
      
      // Users can list/query their own daily activities
      // This allows compound queries with userId, date range, and orderBy
      // Updated to allow queries without userId filter (since we filter by document ID pattern)
      allow list: if isAuthenticated() && 
                  request.query.limit <= 500;
      
      // ADMINS can read all activities
      allow read: if isAdmin();
      
      // TRAINERS can read their assigned clients' activities
      allow get: if isTrainer() && isAssignedTrainer(getUserIdFromActivityId());
      allow list: if isTrainer() && request.query.limit <= 500;
      
      // Validation for activity data
      function validateActivity() {
        let data = request.resource.data;
        return data.keys().hasAll(['userId', 'date', 'updatedAt']) &&
               data.userId is string &&
               data.date is string &&
               data.habits is list;
      }
      
      // Users can write their own daily activities
      allow write: if isAuthenticated() && 
                   request.auth.uid == getUserIdFromActivityId() &&
                   validateActivity();
    }
    
    // WEEKLY SURVEYS SYSTEM - Subjective feedback tracking
    // Collection structure: weeklySurveys/{userId}/responses/{weekStartDate}
    match /weeklySurveys/{userId} {
      // Users can read their own surveys parent document
      allow read: if isOwner(userId);
      
      // ADMINS can read all surveys
      allow read: if isAdmin();
      
      // TRAINERS can read their assigned clients' surveys
      allow read: if isTrainer() && isAssignedTrainer(userId);
      
      // Responses subcollection
      match /responses/{weekStartDate} {
        // Users can read/write their own weekly surveys
        allow read, write: if isOwner(userId);
        
        // ADMINS can read all surveys
        allow read: if isAdmin();
        
        // TRAINERS can read their assigned clients' surveys
        allow read: if isTrainer() && isAssignedTrainer(userId);
        
        // Validation for weekly survey data
        function validateWeeklySurvey() {
          let data = request.resource.data;
          return data.keys().hasAll(['userId', 'weekStartDate', 'weekEndDate', 'ratings', 'adherence', 'wins', 'challenges', 'submittedAt', 'lastUpdated']) &&
                 data.userId is string &&
                 data.weekStartDate is string &&
                 data.weekEndDate is string &&
                 data.ratings is map &&
                 data.ratings.keys().hasAll(['energy', 'sleep', 'mood']) &&
                 data.ratings.energy is number && data.ratings.energy >= 1 && data.ratings.energy <= 5 &&
                 data.ratings.sleep is number && data.ratings.sleep >= 1 && data.ratings.sleep <= 5 &&
                 data.ratings.mood is number && data.ratings.mood >= 1 && data.ratings.mood <= 5 &&
                 data.adherence is map &&
                 data.adherence.keys().hasAll(['workouts', 'nutrition']) &&
                 data.adherence.workouts is number && data.adherence.workouts >= 1 && data.adherence.workouts <= 5 &&
                 data.adherence.nutrition is number && data.adherence.nutrition >= 1 && data.adherence.nutrition <= 5 &&
                 data.wins is string &&
                 data.challenges is string;
        }
        
        allow write: if isOwner(userId) && validateWeeklySurvey();
      }
    }
    
    // PROGRESS PHOTOS SYSTEM - Visual transformation tracking
    // Collection structure: progressPhotos/{userId}_{date}
    match /progressPhotos/{photoDocId} {
      // Extract userId from document ID (format: userId_date)
      function getUserIdFromPhotoId() {
        return photoDocId.split('_')[0];
      }
      
      // Users can read their own progress photos (individual documents)
      allow get: if isAuthenticated() && 
                 request.auth.uid == getUserIdFromPhotoId();
      
      // Users can list/query their own progress photos
      allow list: if isAuthenticated() && 
                  request.query.limit <= 100;
      
      // ADMINS can read all progress photos
      allow read: if isAdmin();
      
      // TRAINERS can read their assigned clients' photos (individual documents)
      allow get: if isTrainer() && isAssignedTrainer(getUserIdFromPhotoId());
      
      // TRAINERS can list progress photos (for their dashboard)
      allow list: if isTrainer() && request.query.limit <= 100;
      
      // Validation for progress photo data
      function validateProgressPhoto() {
        let data = request.resource.data;
        return data.keys().hasAll(['userId', 'date', 'photos', 'createdAt', 'updatedAt']) &&
               data.userId is string &&
               data.date is string &&
               data.photos is map;
      }
      
      // Users can create/update their own progress photos with validation
      allow create, update: if isAuthenticated() && 
                            request.auth.uid == getUserIdFromPhotoId() &&
                            validateProgressPhoto();
      
      // Users can delete their own progress photos (no validation needed for delete)
      allow delete: if isAuthenticated() && 
                    request.auth.uid == getUserIdFromPhotoId();
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
